#!/usr/bin/env bash

# Exit on command errors, unset variables and pipeline failures.
set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")

OMARCHY_BOX_BASE_DIR="${OMARCHY_BOX_BASE_DIR:-${script_dir}}"
OMARCHY_BOX_DATA_DIR="${OMARCHY_BOX_DATA_DIR:-${OMARCHY_BOX_BASE_DIR}/data}"

# Defaults (CLI flags may override before libs that depend on them).
OMARCHY_BOX_INSTANCE="${OMARCHY_BOX_INSTANCE:-default}"
OMARCHY_BOX_CPUS="${OMARCHY_BOX_CPUS:-4}"
OMARCHY_BOX_RAM="${OMARCHY_BOX_RAM:-8192}"
OMARCHY_BOX_SSH_PORT="${OMARCHY_BOX_SSH_PORT:-2222}"
OMARCHY_BOX_SSH_USER="${OMARCHY_BOX_SSH_USER:-omarchy}"
OMARCHY_BOX_SSH_PASS="${OMARCHY_BOX_SSH_PASS:-omarchy}"
OMARCHY_BOX_SSH_HOST="${OMARCHY_BOX_SSH_HOST:-127.0.0.1}"
OMARCHY_BOX_SSH_KEY="${OMARCHY_BOX_SSH_KEY:-}"
OMARCHY_BOX_SSH_TIMEOUT_SECS="${OMARCHY_BOX_SSH_TIMEOUT_SECS:-300}"
OMARCHY_BOX_DISPLAY="${OMARCHY_BOX_DISPLAY:-gui}"
OMARCHY_BOX_VERSION="${OMARCHY_BOX_VERSION:-latest}"
OMARCHY_BOX_MEDIA="${OMARCHY_BOX_MEDIA:-auto}"
OMARCHY_BOX_HOSTNAME="${OMARCHY_BOX_HOSTNAME:-omarchy}"
OMARCHY_BOX_KB_LAYOUT="${OMARCHY_BOX_KB_LAYOUT:-us}"
OMARCHY_BOX_TIMEZONE="${OMARCHY_BOX_TIMEZONE:-UTC}"
OMARCHY_BOX_DISK_GB="${OMARCHY_BOX_DISK_GB:-40}"
OMARCHY_BOX_EPHEMERAL="${OMARCHY_BOX_EPHEMERAL:-false}"
OMARCHY_BOX_ALL="${OMARCHY_BOX_ALL:-false}"
OMARCHY_BOX_SSH_PORT_EXPLICIT="${OMARCHY_BOX_SSH_PORT_EXPLICIT:-false}"

source "${OMARCHY_BOX_BASE_DIR}/lib/cli.sh"
omarchy_box_parse_args "$@"

# Derived paths after --instance is known.
OMARCHY_BOX_INSTANCE_DIR="${OMARCHY_BOX_INSTANCE_DIR:-${OMARCHY_BOX_DATA_DIR}/instances/${OMARCHY_BOX_INSTANCE}}"
OMARCHY_BOX_IMAGE="${OMARCHY_BOX_IMAGE:-${OMARCHY_BOX_INSTANCE_DIR}/disk.qcow2}"

source "${OMARCHY_BOX_BASE_DIR}/lib/arch.sh"
source "${OMARCHY_BOX_BASE_DIR}/lib/dependency_check.sh"
source "${OMARCHY_BOX_BASE_DIR}/lib/firmware.sh"
source "${OMARCHY_BOX_BASE_DIR}/lib/ssh.sh"
source "${OMARCHY_BOX_BASE_DIR}/lib/qemu.sh"
source "${OMARCHY_BOX_BASE_DIR}/lib/lifecycle.sh"
source "${OMARCHY_BOX_BASE_DIR}/lib/media.sh"
source "${OMARCHY_BOX_BASE_DIR}/lib/cidata.sh"
source "${OMARCHY_BOX_BASE_DIR}/lib/instance.sh"

refresh_pidfile_path

mkdir -p "${OMARCHY_BOX_DATA_DIR}" "${OMARCHY_BOX_INSTANCE_DIR}"
cd "${OMARCHY_BOX_DATA_DIR}"

run_action() {
  local action="$1"
  local command="${OMARCHY_BOX_BASE_DIR}/actions/${action}.sh"

  if [[ ! -f "${command}" ]]; then
    echo "Unknown action: ${action}"
    echo
    command="${OMARCHY_BOX_BASE_DIR}/actions/usage.sh"
  fi

  source "${command}"
}

run_action "${OMARCHY_BOX_ACTION}"

if box_running; then
  echo "The box is left running until you press Ctrl+C to stop it."
  wait "${QEMU_PID}"
fi
